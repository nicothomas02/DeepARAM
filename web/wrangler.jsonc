{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the dashboard (renamed from aram-mayhem in place, so it kept
  // its domains, databases and secrets), or Workers Builds refuses to deploy.
  "name": "deeparam",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Per-visitor limits used by src/middleware.ts (per minute, per Cloudflare location). The ids only
  // need to be unique in the account.
  "ratelimits": [
    { "name": "RL_LOOKUP", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_LOG", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SHARE", "namespace_id": "4104", "simple": { "limit": 60, "period": 60 } }
  ],
  // ERRORS: browser errors from /api/log, read by the morning error check.
  // PROFILES: public player pages people publish from My Stats (table profiles).
  // GAMES: games players chose to share, without names or account ids (tables games, sharers, meta).
  // SIM: held the removed Simulator leaderboard (table submissions); no route reads it now. Kept so the data stays.
  "d1_databases": [
    { "binding": "ERRORS", "database_name": "deeparam-errors", "database_id": "a09c155a-a812-4c9a-a5ef-df74082daeaf" },
    { "binding": "PROFILES", "database_name": "deeparam-profiles", "database_id": "20816c13-cbcb-4028-a963-74fefbf2ca81" },
    { "binding": "GAMES", "database_name": "deeparam-games", "database_id": "58bd89f8-7148-4901-b3f8-4e2138c6fd82" },
    { "binding": "SIM", "database_name": "deeparam-sim", "database_id": "ba38e8f1-9eb0-4e6c-8e34-22030a3e048c" }
  ]
}
